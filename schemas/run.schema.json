{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aidong27/99-ai-games/schemas/run.schema.json",
  "title": "99 AI Games Run Record",
  "type": "object",
  "required": ["runId", "gameNumber", "gameSlug", "variantId", "runType", "status", "createdDate", "modelName", "agentName", "humanCodeEdits"],
  "properties": {
    "runId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "gameNumber": { "type": "integer", "minimum": 1, "maximum": 99 },
    "gameSlug": { "type": "string" },
    "variantId": { "type": "string" },
    "runType": { "enum": ["initial-generation", "revision", "validation", "comparison", "benchmark", "release"] },
    "status": { "type": "string" },
    "createdDate": { "type": "string" },
    "modelName": { "type": "string" },
    "agentName": { "type": "string" },
    "humanCodeEdits": { "type": "boolean" },
    "promptSummary": { "type": "string" },
    "outputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification": { "type": "object" },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
