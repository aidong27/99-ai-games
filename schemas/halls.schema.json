{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aidong27/99-ai-games/schemas/halls.schema.json",
  "title": "99 AI Games Halls",
  "type": "object",
  "required": ["projectName", "totalHalls", "slotsPerHall", "totalGameSlots", "slotMixPerHall", "halls"],
  "properties": {
    "projectName": { "const": "99 AI Games" },
    "totalHalls": { "const": 9 },
    "slotsPerHall": { "const": 11 },
    "totalGameSlots": { "const": 99 },
    "numberingPolicy": { "type": "string" },
    "slotVariantRunPolicy": { "type": "string" },
    "slotMixPerHall": {
      "type": "object",
      "required": ["benchmark", "normal", "failed-weird", "future-remake"],
      "properties": {
        "benchmark": { "const": 3 },
        "normal": { "const": 6 },
        "failed-weird": { "const": 1 },
        "future-remake": { "const": 1 }
      }
    },
    "halls": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "required": ["id", "number", "name", "capacity", "description", "assignedGameNumbers"],
        "properties": {
          "id": { "type": "string" },
          "number": { "type": "integer", "minimum": 1, "maximum": 9 },
          "name": { "type": "string" },
          "capacity": { "const": 11 },
          "description": { "type": "string" },
          "assignedGameNumbers": {
            "type": "array",
            "items": { "type": "integer", "minimum": 1, "maximum": 99 }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
